{
  "name": "photo-tag-manager",
  "version": "0.1.5",
  "description": "图片管家 PhotoTagManager - Windows 本机图片管理工具（多根浏览、文件内 XMP 标签整理、回收站清理、本机 AI 人像抠图；Electron + React + Vite + MUI + Tailwind）",
  "main": "./out/main/index.js",
  "author": "Ybond",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --build tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/make-icon.cjs",
    "notice": "node scripts/gen-notice.cjs",
    "notice:check": "node scripts/gen-notice.cjs --check",
    "dist": "electron-builder --publish never",
    "verify:ai-child": "electron-vite build && electron scripts/ai-child-probe.cjs",
    "verify:ai-crash": "electron-vite build && electron scripts/ai-crash-probe.cjs",
    "cdp:up": "node scripts/cdp-up.cjs",
    "cdp:layout": "node scripts/cdp-layout.cjs",
    "app:kill": "taskkill /IM PhotoTagManager.exe /F",
    "app:go": "node scripts/rebuild-run.cjs"
  },
  "build": {
    "appId": "com.ybd0612.phototagmanager",
    "productName": "PhotoTagManager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json",
      "LICENSE",
      "NOTICE",
      "LICENSES/**",
      "!out/main/crashHarness.js",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PhotoTagManager"
    },
    "publish": {
      "provider": "github",
      "owner": "ybd0612",
      "repo": "PhotoTagManager",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.0",
    "@mui/material": "^5.16.0",
    "electron-log": "^5.1.0",
    "electron-updater": "^6.3.9",
    "exiftool-vendored": "^37.0.0",
    "onnxruntime-node": "1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10",
    "sharp": "0.35.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
