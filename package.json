{
  "name": "photo-tag-manager",
  "version": "0.1.0",
  "description": "PhotoTagManager - Windows 桌面图片 XMP 标签管理器（Electron + React + Vite + MUI + Tailwind）",
  "main": "./out/main/index.js",
  "author": "PhotoTagManager Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --build tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.ybd0612.phototagmanager",
    "productName": "PhotoTagManager",
    "directories": { "output": "dist" },
    "files": ["out/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PhotoTagManager"
    },
    "publish": { "provider": "github", "owner": "ybd0612", "repo": "PhotoTagManager" }
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.0",
    "@mui/material": "^5.16.0",
    "electron-log": "^5.1.0",
    "electron-updater": "^6.3.9",
    "exiftool-vendored": "^37.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
